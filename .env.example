# ============================================================
# CacheForge Environment Configuration Template
# ============================================================

# Backend Port (default: 8080)
PORT=8080

# Environment Mode (development | production)
NODE_ENV=production

# Directory where binary database files (*.db, *.dat, *.log) are persisted
# On Docker / Render: /data/cacheforge
# Locally on Windows: C:\Users\ABHIRAM\CacheForge\data (or relative ../data)
CACHEFORGE_DATA_DIR=../data

# Explicit path to compiled C++ binary (optional; auto-detected if left unset)
# CACHEFORGE_BIN=../build/cacheforge.exe

# Allowed CORS origins (e.g. https://cacheforge.vercel.app or * for open development)
CORS_ORIGIN=*

# Frontend API Base URL (used during frontend build or runtime)
# Leave empty for same-origin proxy in local dev, or set to your deployed backend URL:
# VITE_API_BASE_URL=https://cacheforge-backend.onrender.com
VITE_API_BASE_URL=
